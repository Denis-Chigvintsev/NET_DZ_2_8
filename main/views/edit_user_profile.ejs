<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
        <br/>
    <div class='form_wrap'>
        <h4>Отредактируйте Ваши данные</h4>
        
        <form method="post" action="/api/users/edit_user_profile/<%=i_user[0].id%>"> 
            <div>Логин: <%=i_user[0].login%></div>
            <br />

          <label>
            
            
            Имя:
            <input type='text' name='first_name' id="first_name" value="<%=i_user[0].first_name %>"  size="40"/>
          </label>
          <br />
          <br />
          <label>
            Фамилия:
            <input type='text' name='last_name'   value="<%=i_user[0].last_name %>" size="35" />
          </label>
          <br />
          <br />
          <label>
            Дата Рождения:
            <input type='text' name='DOB'   value="<%=i_user[0].DOB %>" size="29"/>
          </label>
          <br />
          <br />
          <label>
            Телефон:
            <input type='text' name='phone1' value="<%=i_user[0].phone1 %>" size="36"   />
          </label>
          <br />
          <br />
          <label>
            Второй телефон:
            <input type='text' name='phone2'  value="<%=i_user[0].phone2 %>"  size="28"/>
          </label>
          <br />
          <br />
          <label>
            Электронная почта:
            <input type='text' name='email'  value="<%=i_user[0].email %>" size="25" />
          </label>
          <br />
          <br />
          <button type='submit'>Обновить профиль</button>
        </form>
        <br/>

</body>
</html>

<style>
    .form_wrap {
        width: 360px;        
        border:1px solid grey;
        border-radius: 5px;
        border: 1px solid darkgray;     
        padding: 10px;        
      }    
    </style>