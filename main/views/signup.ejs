<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <div class="layout_container">
      <form class="signup_form" action="/api/users/signup" method="post">
        <h4>Регистрация нового пользователя</h4>
        <label for=""
          >Имя пользователя:
          <input type="text" name="login" id="login" />
        </label>
        <br /><br />
        <label for=""
          >Пароль:
          <input type="password" name="password" id="password" size="31" />
        </label>
        <br /><br />
        <button type="submit">Зарегистрировать</button>
      </form>
      <div class="a_tag">
        <a href="/api/users/login">Перейти на страницу входа</a>
      </div>
    </div>
  </body>
</html>

<style>
  .signup_form {
    width: 320px;

    border: 1px solid grey;
    border-radius: 5px;
    border: 1px solid darkgray;
    padding: 10px;
    padding-top: 5px;
    margin: 0 auto;
    margin-top: 30px;
  }

  body {
    display: flex;
    justify-content: center;
  }
  a {
    text-decoration: none;
  }

  .a_tag {
    text-align: center;
    margin-top: 5px;
  }
  .layout_container {
    width: 70%;
    min-height: 90vh;
    background-color: whitesmoke;
    border: 1px solid lightgray;
    padding: 3%;
  }

  a:hover {
    text-shadow: 1px 1px lightgrey;
  }
  html {
    margin-top: -20px;
  }
  button {
    border: 1px solid grey;
    border-radius: 2px;
    box-shadow: 1px 1px;
    cursor: pointer;
  }
  button:hover {
    border: 1px solid black;
    box-shadow: 1px 1px black;
    text-shadow: 1px;
    color: black;
  }
</style>
